////
//// Zenoh Bridge Configuration for Robot Client
//// Mode: Client - Connects to orchestrator router
//// ROS 2 Humble, Domain ID: 10
////
//// IMPORTANT: Update the following for each robot:
//// 1. namespace: "/robot_2" -> Change to robot_2, robot_3, robot_4, etc.
//// 2. nodename: Change suffix to match robot ID
////
{
  ////
  //// Zenoh client mode - connects to central router
  ////
  mode: "client",
  
  ////
  //// Connect to orchestrator at 192.168.50.60:7447
  ////
  connect: {
    endpoints: ["tcp/192.168.50.60:7447"]
  },
  
  ////
  //// Plugins configuration
  ////
  plugins: {
    ////
    //// ROS2 DDS Bridge Plugin
    ////
    ros2dds: {
      ////
      //// Node name for this bridge instance
      //// CHANGE THIS for each robot: zenoh_bridge_robot_2, zenoh_bridge_robot_3, etc.
      ////
      nodename: "zenoh_bridge_robot_2",
      
      ////
      //// NO namespace needed here! 
      //// Robot's Nav2 stack already runs with namespace (robot_2, robot_3, etc.)
      //// So all topics are already published as robot_2/tf, robot_2/initialpose, etc.
      //// Using "/" means Zenoh will pass topics as-is without adding extra prefix
      ////
      
      ////
      //// DDS Domain ID (must match ROS_DOMAIN_ID and orchestrator)
      ////
    //   domain: 10,
      
      ////
      //// Allow ROS discovery across network
      ////
    //   ros_localhost_only: false,
      
      ////
      //// Discovery range for ROS 2 nodes
      ////
    //   ros_automatic_discovery_range: "SUBNET",
      
      ////
      //// Whitelist: Only bridge necessary topics
      //// IMPORTANT: Patterns match FULL topic names as they appear in ROS
      //// Since Nav2 already runs with namespace, topics are already robot_X/topic_name
      //// So we match full paths: robot_2/tf, robot_2/initialpose, etc.
      ////
      allow: {

        publishers: [
          "*/tf",
          "*/nav2_goal_status",
          "*/nav2_goal_result"
        ],

        subscribers: [".*/initialpose_external"],

        service_servers: [".*"],

        service_clients: [".*"],

        action_servers: [".*/navigate_to_pose"],

      },
      
      //// queries_timeout: Timeouts configuration for various Zenoh queries.
      ////                  Each field is optional. If not set, the 'default' timeout (5.0 seconds by default) applies to all queries,
      ////                  except for actions' get_result that is by default configured with a larget timeout (300.0 seconds)
      ////                  to support actions that last a long time.
      ////                  Refer to https://github.com/eclipse-zenoh/zenoh-plugin-ros2dds/issues/369#issuecomment-2563725619
      ////                  Each value can be either a float in seconds that will apply as a timeout to all queries,
      ////                  either a list of strings with format "<regex>=<float>" where:
      ////                      - "regex" is a regular expression matching an interface name
      ////                      - "float" is the timeout in seconds
      queries_timeout: {
        //// default timeout that will apply to all query, except the ones specified below
        //// in 'transient_local_subscribers', 'services' and 'actions'
        default: 5.0,
        //// timeouts for TRANSIENT_LOCAL subscriber when querying publishers for historical publications
        transient_local_subscribers: 5.0,
        //// timeouts for Service clients calling a Service server
        //// timeouts for Action clients calling an Action server (send_goal, cancel_goal and get_result services)
        actions: {
          send_goal: 5.0,
          cancel_goal: 5.0,
          get_result: [".*long_mission=3600", ".*short_action=10.0", ".*=300"],
        }
      },

      ////
      //// Frequency limiting to reduce WiFi bandwidth
      //// TF updates: 10 Hz is sufficient for orchestrator coordination
      ////
    }
  }
}
